# SpaceXAI / xAI — required for live agent responses
# Get a key: https://console.x.ai
# Without this key, DevForge uses the labeled local mock agent.
XAI_API_KEY=your_api_key_here

# Optional model override (default: grok-4.5)
XAI_MODEL=grok-4.5

# Terminal: real (default) runs a local shell in .devforge-workspace/
# On Vercel, real uses ephemeral /tmp storage and requires this token.
# Set to mock only if you want simulated output again.
# DEVFORGE_TERMINAL_MODE=real
# DEVFORGE_TERMINAL_TOKEN=choose_a_long_random_token
# DEVFORGE_WORKSPACE_ROOT=/absolute/path/to/workspace
